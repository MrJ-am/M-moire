(defpackage #:matheval-tests (:use #:cl) (:export #:verifier))
(in-package #:matheval-tests)

(defun verifier ()
  (let ((r (matheval:generateur-32 0)))
    ;; Vecteur produit par le JS de référence, testé aussi différentiellement.
    (assert (equal (loop repeat 4 collect (funcall r))
                   '(1144304738 1416247 958946056 627933444))))
  (let ((r (matheval:resume '(0 :null 1 2 3))))
    (assert (= 4 (vision:json-object-get r "n")))
    (assert (= 1.5d0 (vision:json-object-get r "mean")))
    (assert (= 0.75d0 (vision:json-object-get r "q1"))))
  (assert (eq :null (vision:json-object-get (matheval:resume '()) "mean")))
  (let ((d (matheval:distribution '(-9) 2 -10 10)))
    (assert (= 1 (vision:json-object-get (second (vision:json-array-items d)) "count"))))
  (assert (equal '(1 2 3) (sort (matheval:melanger '(1 2 3) (matheval:generateur-32 17)) #'<)))
  (format t "Matheval : contrôles purs réussis.~%") t)
