{
  "name": "memoire-prototype-tests",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build:main": "node scripts/build-elm.cjs && python3 scripts/build-bank.py && node scripts/version-assets.cjs && cp data/exercise-001.json site/data/",
    "test:logic": "node scripts/test-elm.cjs",
    "test:e2e": "npx playwright test",
    "test:e2e:guix": "bash scripts/patch-playwright-firefox.sh && PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1 npx playwright test",
    "test:e2e:install": "npx playwright install firefox chromium",
    "test:e2e:install:ci": "npx playwright install --with-deps firefox chromium",
    "test:all": "npm run check:data && npm run test:data && npm run test:logic && npm run test:e2e",
    "build:data": "python3 scripts/build-bank.py && node scripts/version-assets.cjs && node scripts/validate-bank.cjs",
    "check:data": "python3 scripts/build-bank.py --check && node scripts/validate-bank.cjs --check",
    "test:data": "python3 -m unittest discover -s tests -p 'test_org_bank.py'",
    "predev": "npm run build:data"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@lydell/elm": "0.19.1-14",
    "elm-format": "^0.8.8",
    "elm-test": "^0.19.1-revision16",
    "vite": "^8.3.0"
  }
}
